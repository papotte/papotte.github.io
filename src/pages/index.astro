---
import Contact from '@components/Contact.astro';
import AboutSection from '@components/AboutSection.astro';
import Capabilities from '@components/Capabilities.astro';
import Credentials from '@components/Credentials.astro';
import Footer from '@components/Footer.astro';
import { IconMap } from '@lib/style-helper';
import Jumbotron from '@components/Jumbotron.astro';
import NavBar from '@components/NavBar.astro';
import Projects from '@components/Projects.astro';
import Stack from '@components/Stack.astro';
import { getContent } from '@/content';
import BaseHead from '@layouts/BaseHead.astro';

const {
	about,
	capabilities,
	contactInfo,
	credentials,
	data,
	name,
	projects,
	skills,
	socialLinks,
	technicalInterests,
	website,
} = await getContent();
const social = Object.entries(socialLinks).map(([name, url]) => ({
	name,
	href: url,
	icon: IconMap[name as keyof typeof IconMap],
}));
const title = `CV | ${name}`;
const description = `${name} | ${data.title} | ${data.tagline}`;
---

<html lang="en" data-theme="light">
	<head>
		<BaseHead title={title} name={name} description={description} />
	</head>
	<body class="flex min-h-screen flex-col bg-[#f8fbff] text-slate-900">
		<NavBar name={name} website={website} />
		<main>
			<section class="bg-gradient-to-br from-[#4682B4] via-[#3d719d] to-[#2b4d6a]">
				<Jumbotron title={data.title} description={data.tagline} />
			</section>
			<AboutSection about={about} technicalInterests={technicalInterests} name={name} skills={skills} />
			<Capabilities value={capabilities} />
			<Stack skills={skills} />
			<Credentials value={credentials} />
			<Projects value={projects} />
			<Contact contactInfo={contactInfo} links={social} />
		</main>
		<Footer />
	</body>
</html>
