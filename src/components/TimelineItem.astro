---
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
const { title, subtitle, description, time, labels } = Astro.props;
---

<li class="group relative flex w-1/2 flex-row gap-x-4 self-end py-8 even:flex-row-reverse even:self-start">
	<div class="absolute h-full w-[1px] bg-pink-600"></div>
	<div
		class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-pink-600 group-odd:-ml-3 group-even:-mr-3"
	>
	</div>

	<div class="flex flex-col items-start gap-2 truncate pt-1 whitespace-normal text-slate-900 group-even:items-end">
		<time class="mb-2 block leading-none font-bold text-slate-600">{time}</time>

		<h2 class="font-bold text-sky-800">{title}</h2>
		<h3>{subtitle}</h3>
		<div class="text-start font-normal text-slate-600 group-even:text-end">
			<Fragment set:html={documentToHtmlString(description)} />
		</div>

		<div class="flex flex-wrap gap-2 text-start group-even:text-end">
			{
				labels &&
					labels.map((label) => (
						<span class="inline-block rounded-full bg-cyan-100 px-2.5 py-0.5 text-xs font-medium whitespace-nowrap text-cyan-800 dark:bg-cyan-800 dark:text-cyan-400">
							{label}
						</span>
					))
			}
		</div>
	</div>
</li>
