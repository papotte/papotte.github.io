---
import { Icon } from 'astro-icon/components';

import type { Content } from '@/content';

interface Props {
	contactInfo: Content['contactInfo'];
	links: Array<{
		href: string;
		name: string;
		icon: string;
	}>;
}

const { contactInfo, links } = Astro.props as Props;
const obfuscatedEmail = contactInfo.email.split('').reverse().join('');
---

<section id="contact" class="bg-slate-100/70">
	<div class="mx-auto max-w-screen-xl px-4 py-16 text-center md:px-8 lg:py-24">
		<div class="mb-6 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.2em] text-sky-700 uppercase">
			<span class="h-px w-8 bg-slate-300"></span>
			<span>Let's Connect</span>
			<span class="h-px w-8 bg-slate-300"></span>
		</div>
		<h2 class="mx-auto max-w-4xl text-3xl leading-tight font-light text-slate-900 md:text-5xl">
			Ready to build something extraordinary?
		</h2>
		<p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-slate-600 md:text-base">
			Collaborate on your next mission-critical digital initiative. I focus on reliable delivery, sharp execution, and
			measurable outcomes.
		</p>

		<div class="mt-8 flex items-center justify-center">
			<button
				id="email-me-button"
				type="button"
				class="btn btn-primary px-8 text-xs font-semibold tracking-[0.14em] uppercase"
				data-email={obfuscatedEmail}
			>
				<Icon name="ic:round-email" class="h-5 w-5" />
				Email me
			</button>
		</div>
		<p id="email-copy-feedback" class="mt-3 text-sm font-medium text-sky-700" aria-live="polite"></p>

		<div class="mt-8">
			<p class="mb-3 text-xs font-semibold tracking-widest text-slate-500 uppercase">Social</p>
			<div class="flex flex-wrap justify-center gap-3">
				{
					links.map((link) => (
						<a
							href={link.href}
							aria-label={link.name}
							class="text-slate-500 transition hover:text-sky-700"
							target="_blank"
							rel="noreferrer"
						>
							<Icon name={link.icon} class="h-7 w-7" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>

<script is:inline>
	const button = document.getElementById('email-me-button');

	if (button instanceof HTMLButtonElement) {
		const feedback = document.getElementById('email-copy-feedback');

		button.addEventListener('click', () => {
			const reversedEmail = button.dataset.email ?? '';
			const email = reversedEmail.split('').reverse().join('');
			const copyWithFallback = async () => {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(email);
					return true;
				}

				return false;
			};

			copyWithFallback()
				.then((didCopy) => {
					if (feedback) {
						feedback.textContent = didCopy ? 'Email copied to clipboard.' : `Copy this email: ${email}`;
					}
				})
				.catch(() => {
					if (feedback) {
						feedback.textContent = 'Could not copy automatically.';
					}
				});
		});
	}
</script>
