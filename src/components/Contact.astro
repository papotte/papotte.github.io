---
import { Icon } from 'astro-icon/components';

const accessToken = import.meta.env.WEB3FORMS_ACCESS_TOKEN;
---

<section id="contact">
	<div class="flex-col gap-x-4 gap-y-8 text-center lg:gap-y-16">
		<h1 class="text-justify text-4xl leading-none font-extrabold tracking-tight md:text-5xl lg:text-6xl">
			Get in touch
		</h1>
		<div class="flex w-full flex-col justify-between gap-8 md:flex-row">
			<form
				action="https://api.web3forms.com/submit"
				method="POST"
				class="text-base-content mx-auto flex w-2/3 flex-col gap-6 text-left"
			>
				<input type="hidden" name="access_key" value={accessToken} />
				<div>
					<label for="name" class="mb-2 block text-sm font-medium">
						Your name
						<div class="relative">
							<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
								<Icon name="ic:round-person" class="h-4 w-4" />
							</div>
							<input
								type="text"
								id="name"
								autocomplete="name"
								name="name"
								class="input input-bordered input-primary w-full pl-10"
								placeholder="Your full name"
								required
							/>
						</div>
					</label>
				</div>
				<div>
					<label for="email-address-icon" class="mb-2 block text-sm font-medium">
						Your Email
						<div class="relative">
							<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
								<Icon name="ic:baseline-alternate-email" class="h-4 w-4" />
							</div>
							<input
								type="email"
								name="email"
								autocomplete="email"
								required
								id="email-address-icon"
								class="input input-bordered input-primary w-full pl-10"
								placeholder="name@email.com"
							/>
						</div>
					</label>
				</div>
				<div>
					<label for="message" class="mb-2 block text-sm font-medium">
						Your message
						<div class="relative">
							<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
								<Icon name="ic:round-message" class="h-4 w-4" />
							</div>
							<textarea
								id="message"
								name="message"
								rows="4"
								required
								class="textarea textarea-bordered textarea-primary w-full pl-10"
								placeholder="Leave a message..."></textarea>
						</div>
					</label>
				</div>

				<div class="h-captcha self-center md:self-start" data-captcha="true"></div>
				<div class="mb-6 flex items-start">
					<button type="submit" class="btn btn-primary w-full sm:w-auto">Submit</button>
				</div>
			</form>

			<div class="border-primary w-48 self-center border-2 md:w-96">
				<img src="mention.svg" alt="Person holding a phone" class="h-full w-full object-cover" />
			</div>
		</div>
	</div>
</section>

<script src="https://web3forms.com/client/script.js" async defer></script>
