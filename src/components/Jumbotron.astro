---
const { title, description } = Astro.props;
---

<section id="home">
	<div
		class="mx-auto flex max-w-screen-xl flex-col gap-10 px-4 py-18 md:px-8 lg:flex-row lg:items-center lg:gap-12 lg:py-24"
	>
		<div class="min-w-0 flex-1 space-y-8">
			<p class="text-xs font-semibold tracking-[0.2em] text-white/80 uppercase">Strategic Engineering Portfolio</p>
			<h1 class="text-4xl leading-tight font-light text-slate-100 md:text-5xl lg:text-6xl">{title}</h1>
			<p class="text-base leading-8 text-slate-200 md:text-lg">{description}</p>
			<div class="flex flex-wrap gap-4 pt-2">
				<a href="#projects" class="btn btn-secondary px-6 text-xs font-semibold tracking-wider"> VIEW CASE STUDIES </a>
				<a
					href="#about"
					class="btn btn-outline px-6 text-xs font-semibold tracking-wider text-slate-100 hover:border-slate-100 hover:bg-slate-100 hover:text-slate-900"
				>
					ABOUT
				</a>
			</div>
		</div>
		<div class="relative w-full shrink-0 overflow-hidden border border-white/10 shadow-2xl lg:max-w-md lg:flex-1">
			<div class="aspect-[4/5] w-full bg-slate-900/30">
				<img
					src="/dev-setup.png"
					alt=""
					class="h-full w-full object-cover opacity-90 grayscale transition duration-1000 hover:grayscale-0"
					loading="eager"
					decoding="async"
				/>
				<div class="pointer-events-none absolute inset-0 bg-[#4682B4]/15" aria-hidden="true"></div>
			</div>
		</div>
	</div>
</section>
