---
import type { Content } from '@/content';
import Card from './Card.astro';

interface Props {
	value: Content['credentials'];
}

const { value: credentials = [] } = Astro.props as Props;

const normalizeIcon = (icon?: string) => {
	const iconMap: Record<string, string> = {
		'material-symbols:cloud-done-outline-rounded': 'ic:round-cloud-done',
		'material-symbols:verified-outline-rounded': 'ic:round-verified',
		'material-symbols:workspace-premium-outline-rounded': 'ic:round-workspace-premium',
	};
	return iconMap[icon ?? ''] ?? icon ?? 'ic:round-workspace-premium';
};
---

{
	credentials.length > 0 && (
		<section id="credentials" class="bg-slate-50">
			<div class="mx-auto flex max-w-screen-xl flex-col gap-10 px-4 py-16 md:px-8 lg:py-20">
				<div class="space-y-3">
					<p class="text-xs font-semibold tracking-[0.2em] text-sky-700 uppercase">Credentials</p>
					<h2 class="text-3xl leading-tight font-light text-slate-900 md:text-4xl">Professional Certifications</h2>
					<p class="max-w-xl text-sm leading-7 font-light text-slate-600">
						Validated expertise in cloud architecture and scalable systems.
					</p>
				</div>

				<div class="grid gap-6 md:grid-cols-2">
					{credentials.map((item) => (
						<Card icon={normalizeIcon(item.icon)} title={item.name} description={item.description} />
					))}
				</div>
			</div>
		</section>
	)
}
