---
import { Icon } from 'astro-icon/components';
---

<footer id="footer">
	<div
		class="wrapper mx-auto w-full max-w-screen-xl justify-center gap-x-4 gap-y-8 border-t border-slate-200 px-4 py-10 md:justify-between md:px-8"
	>
		<div class="wrapper justify-center text-xs font-medium tracking-wide text-slate-500 uppercase">
			<span>© All rights are reserved</span>
			<span>{new Date().getFullYear()}</span>
			<span class="gap-1 tracking-normal normal-case">
				Made with
				<Icon name="ic:round-favorite" class="h-5 w-5 text-pink-500" /> by <a href="https://github.com/papotte"
					>Ross Bermudez</a
				>
				with
				<Icon name="logos:astro" class="h-6 w-10" />
			</span>
		</div>
	</div>
</footer>

<style>
	@reference '../styles/tailwind.css';

	.wrapper {
		@apply flex flex-row flex-wrap md:flex-nowrap;
	}

	span {
		@apply flex flex-row items-center whitespace-nowrap after:mx-2 after:content-['|'] last:after:content-[''];
	}

	a {
		@apply text-sky-700;
	}
</style>
