---
import { Icon } from 'astro-icon/components';

const accessToken = import.meta.env.WEB3FORMS_ACCESS_TOKEN;
---

<form
	action="https://api.web3forms.com/submit"
	method="POST"
	class="mx-auto flex w-full flex-col gap-6 border border-slate-200 bg-white p-6 text-left shadow-sm lg:mx-0 lg:w-2/3 lg:p-8"
>
	<input type="hidden" name="access_key" value={accessToken} />
	<div>
		<label for="name" class="mb-2 block text-sm font-medium">
			Your name
			<div class="relative">
				<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
					<Icon name="ic:round-person" class="h-4 w-4" />
				</div>
				<input
					type="text"
					id="name"
					autocomplete="name"
					name="name"
					class="input input-bordered w-full border-slate-300 pl-10 focus:border-sky-700 focus:outline-none"
					placeholder="Your full name"
					required
				/>
			</div>
		</label>
	</div>
	<div>
		<label for="email-address-icon" class="mb-2 block text-sm font-medium">
			Your Email
			<div class="relative">
				<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
					<Icon name="ic:baseline-alternate-email" class="h-4 w-4" />
				</div>
				<input
					type="email"
					name="email"
					autocomplete="email"
					required
					id="email-address-icon"
					class="input input-bordered w-full border-slate-300 pl-10 focus:border-sky-700 focus:outline-none"
					placeholder="name@email.com"
				/>
			</div>
		</label>
	</div>
	<div>
		<label for="message" class="mb-2 block text-sm font-medium">
			Your message
			<div class="relative">
				<div class="text-secondary pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
					<Icon name="ic:round-message" class="h-4 w-4" />
				</div>
				<textarea
					id="message"
					name="message"
					rows="4"
					required
					class="textarea textarea-bordered w-full border-slate-300 pl-10 focus:border-sky-700 focus:outline-none"
					placeholder="Leave a message..."></textarea>
			</div>
		</label>
	</div>

	<div class="h-captcha self-center md:self-start" data-captcha="true"></div>
	<div class="mb-2 flex items-start">
		<button type="submit" class="btn btn-primary w-full px-6 text-xs font-semibold tracking-wider sm:w-auto">
			Submit
		</button>
	</div>
</form>

<script src="https://web3forms.com/client/script.js" async defer></script>
