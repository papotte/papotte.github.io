---
import { Icon } from 'astro-icon/components';
const { color = 'secondary' } = Astro.props;

const colorVariants: Record<string, string> = {
	primary: 'btn-primary',
	secondary: 'btn-secondary',
	tertiary: 'btn-neutral',
	accent: 'btn-accent',
};
---

<print-button>
	<button type="button" class={`btn btn-square ${colorVariants[color] ?? colorVariants.secondary}`}>
		<Icon name="ic:round-print" class="h-8 w-8" />
	</button>
</print-button>
<script>
	class PrintButton extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button');
			button.addEventListener('click', () => {
				window.print();
			});
		}
	}

	customElements.define('print-button', PrintButton);
</script>
