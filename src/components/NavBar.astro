---
import { name, website } from '@/content';

const pages = [
	{ title: 'About', href: '#about' },
	{ title: 'Skills', href: '#skills' },
	{ title: 'Experience', href: '#experience' },
	{ title: 'Contact', href: '#contact' },
];
---

<div class="navbar bg-base-100 mx-auto w-full max-w-screen-xl px-4 shadow-sm">
	<div class="navbar-start">
		<div class="dropdown">
			<div tabindex="0" role="button" class="btn btn-ghost md:hidden" aria-label="Open menu">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-5 w-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</div>
			<ul tabindex="-1" class="menu menu-sm dropdown-content rounded-box bg-base-100 z-50 mt-3 w-52 p-2 shadow">
				{
					pages.map((page) => (
						<li>
							<a href={page.href}>{page.title}</a>
						</li>
					))
				}
			</ul>
		</div>
		<a href={website} class="btn btn-ghost text-xl">{name}</a>
	</div>
	<div class="navbar-center hidden md:flex">
		<ul class="menu menu-horizontal px-1">
			{
				pages.map((page) => (
					<li>
						<a href={page.href}>{page.title}</a>
					</li>
				))
			}
		</ul>
	</div>
</div>
